{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "runtime",
    "declaration": true,
    "sourceMap": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "contracts/**/*.ts",
    "errors/**/*.ts",
    "http/**/*.ts",
    "services/**/*.ts"
  ],
  "exclude": ["runtime"]
}
